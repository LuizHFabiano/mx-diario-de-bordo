generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  ATTENDANT
}

enum WorkDayStatus {
  OPEN
  CLOSED
}

enum ShiftType {
  MORNING
  AFTERNOON
  NIGHT
}

enum ScheduleStatus {
  WORK
  OFF
  MEDICAL
  ABSENT
}

enum AuditAction {
  USER_CREATED
  USER_UPDATED
  USER_DELETED
  PASSWORD_CHANGED
  TEAM_CREATED
  TEAM_UPDATED
  CATEGORY_CREATED
  CATEGORY_UPDATED
  TASK_CREATED
  TASK_UPDATED
  TASK_DELETED
  WORK_DAY_CLOSED
  SESSION_REVOKED
}

model User {
  id                 String        @id @default(uuid()) @db.Uuid
  name               String        @db.VarChar(120)
  username           String        @unique @db.VarChar(64)
  passwordHash       String        @map("password_hash")
  mustChangePassword Boolean       @default(false) @map("must_change_password")
  role               Role          @default(ATTENDANT)
  isActive           Boolean       @default(true) @map("is_active")
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships        UserTeam[]
  managedTeams       TeamManager[]
  createdTasks       Task[]        @relation("TaskCreator")
  updatedTasks       Task[]        @relation("TaskLastEditor")
  closedWorkDays     WorkDay[]     @relation("WorkDayClosedBy")
  sessions           Session[]
  auditLogs          AuditLog[]    @relation("AuditActor")
  workScales         WorkScale[]
}

model Team {
  id          String        @id @default(uuid()) @db.Uuid
  name        String        @unique @db.VarChar(100)
  code        String        @unique @db.VarChar(50)
  isActive    Boolean       @default(true) @map("is_active")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships UserTeam[]
  managers    TeamManager[]
  workDays    WorkDay[]
  tasks       Task[]
}

model UserTeam {
  userId    String   @map("user_id") @db.Uuid
  teamId    String   @map("team_id") @db.Uuid
  isPrimary Boolean  @default(false) @map("is_primary")
  joinedAt  DateTime @default(now()) @map("joined_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Restrict)

  @@id([userId, teamId])
  @@index([teamId])
  @@map("user_teams")
}

model TeamManager {
  userId     String   @map("user_id") @db.Uuid
  teamId     String   @map("team_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Restrict)

  @@id([userId, teamId])
  @@index([teamId])
  @@map("team_managers")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(100)
  color     String   @db.VarChar(7)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  tasks     Task[]
}

model WorkDay {
  id         String        @id @default(uuid()) @db.Uuid
  teamId     String        @map("team_id") @db.Uuid
  date       DateTime      @db.Date
  status     WorkDayStatus @default(OPEN)
  closedAt   DateTime?     @map("closed_at") @db.Timestamptz(3)
  closedById String?       @map("closed_by_id") @db.Uuid
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  team       Team          @relation(fields: [teamId], references: [id], onDelete: Restrict)
  closedBy   User?         @relation("WorkDayClosedBy", fields: [closedById], references: [id], onDelete: Restrict)
  tasks      Task[]

  @@unique([teamId, date])
  @@index([date])
  @@map("work_days")
}

model Task {
  id             String    @id @default(uuid()) @db.Uuid
  workDayId      String    @map("work_day_id") @db.Uuid
  teamId         String    @map("team_id") @db.Uuid
  categoryId     String?   @map("category_id") @db.Uuid
  createdById    String    @map("created_by_id") @db.Uuid
  lastEditedById String?   @map("last_edited_by_id") @db.Uuid
  title          String    @db.VarChar(200)
  description    String?   @db.Text
  startedAt      DateTime  @map("started_at") @db.Timestamptz(3)
  endedAt        DateTime? @map("ended_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  workDay        WorkDay   @relation(fields: [workDayId], references: [id], onDelete: Restrict)
  team           Team      @relation(fields: [teamId], references: [id], onDelete: Restrict)
  category       Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy      User      @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  lastEditedBy   User?     @relation("TaskLastEditor", fields: [lastEditedById], references: [id], onDelete: Restrict)

  @@index([teamId, startedAt])
  @@index([createdById, startedAt])
  @@index([workDayId])
  @@map("tasks")
}

model SystemSetting {
  id               String   @id @default("global") @db.VarChar(20)
  dayStart         String   @default("08:00") @map("day_start") @db.VarChar(5)
  dayEnd           String   @default("23:00") @map("day_end") @db.VarChar(5)
  allowManualClose Boolean  @default(false) @map("allow_manual_close")
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  actorId    String?     @map("actor_id") @db.Uuid
  action     AuditAction
  entityType String      @map("entity_type") @db.VarChar(50)
  entityId   String      @map("entity_id") @db.VarChar(100)
  metadata   Json?
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  actor      User?       @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

model WorkScale {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  teamId    String?   @map("team_id") @db.Uuid
  shift     ShiftType @default(MORNING)
  weekStart DateTime  @map("week_start") @db.Date

  monday    ScheduleStatus @default(WORK)
  tuesday   ScheduleStatus @default(WORK)
  wednesday ScheduleStatus @default(WORK)
  thursday  ScheduleStatus @default(WORK)
  friday    ScheduleStatus @default(WORK)
  saturday  ScheduleStatus @default(WORK)
  sunday    ScheduleStatus @default(OFF)

  // NOVOS CAMPOS PARA OBSERVAÇÃO DE CADADIA (Justificativas de folga, atestado, etc)
  mondayNotes    String? @map("monday_notes") @db.Text
  tuesdayNotes   String? @map("tuesday_notes") @db.Text
  wednesdayNotes String? @map("wednesday_notes") @db.Text
  thursdayNotes  String? @map("thursday_notes") @db.Text
  fridayNotes    String? @map("friday_notes") @db.Text
  saturdayNotes  String? @map("saturday_notes") @db.Text
  sundayNotes    String? @map("sunday_notes") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
  @@map("work_scales")
}